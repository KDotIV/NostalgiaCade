<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <!-- IIS validates requestTimeout in whole-minute increments. -->
    <httpPlatform processPath="%HOME%\site\wwwroot\ncade-api.exe"
                  arguments="--listen 127.0.0.1:%HTTP_PLATFORM_PORT% --behind-tls-proxy"
                  processesPerApplication="1"
                  startupTimeLimit="60"
                  requestTimeout="00:01:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="%HOME%\LogFiles\ncade-api">
    </httpPlatform>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
