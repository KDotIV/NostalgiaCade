<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NostalgiaCade.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Background" Value="#11141C" />
      <Setter Property="Foreground" Value="#F5F4F0" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#A6AEBD" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#1A1F2A" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#DDF68D" />
      <Setter Property="Foreground" Value="#182216" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="16,14" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </Application.Styles>
</Application>
